# =====================================================================
# Configuración de APIs — Ingeniería de Soluciones con IA
# Copia este archivo a `.env` y completa las keys.
# Todos los proveedores son GRATIS y NO piden tarjeta de crédito.
# =====================================================================

# --- Chat / LLM: Groq -------------------------------------------------
# API compatible con OpenAI, por eso el código usa el cliente `OpenAI`.
# Obtén tu key en: https://console.groq.com/keys
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""

# Modelos de chat. Si no defines estas variables, el código usa los de Groq
# por defecto. Existen para poder cambiar de proveedor sin tocar los notebooks
# (útil si te quedas sin cuota diaria).
LLM_MODEL="llama-3.3-70b-versatile"
LLM_MODEL_SMALL="llama-3.1-8b-instant"

# --- Alternativa: Mistral (misma API compatible con OpenAI) -----------
# Para usar Mistral en vez de Groq, comenta las 4 líneas de arriba y
# descomenta estas. Key gratuita en: https://console.mistral.ai/api-keys
# LLM_BASE_URL="https://api.mistral.ai/v1"
# LLM_API_KEY=""
# LLM_MODEL="mistral-small-latest"
# LLM_MODEL_SMALL="ministral-8b-latest"

# --- Embeddings: Google AI Studio (Gemini) ----------------------------
# Groq NO ofrece endpoint de embeddings, por eso RA1/IL1.3 y RA1/IL1.4
# usan Gemini. Basta la cuenta de Google que ya usas para Colab.
# Obtén tu key en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# --- Observabilidad: LangSmith (opcional, se usa en RA1/IL1.4 y RA3) --
# Obtén tu key en: https://smith.langchain.com/settings
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ingenieria-soluciones-ia"
